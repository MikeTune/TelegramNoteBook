# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Numeric Telegram user IDs allowed to use this private bot (comma-separated).
# Leave empty only for local development; set it in production.
ALLOWED_USER_IDS=123456789

# All reminder times are interpreted in this IANA timezone.
TIMEZONE=Africa/Addis_Ababa

# Linux VPS: persistent directory for the SQLite database, photos and PDFs.
# Leave unset for local development (project directory is used).
# DATA_DIR=/var/lib/knowledge-library

# Optional individual overrides (default to paths under DATA_DIR):
# DB_PATH=/var/lib/knowledge-library/knowledge_library.db
# PHOTOS_DIR=/var/lib/knowledge-library/document_photos
# EXPORTS_DIR=/var/lib/knowledge-library/exports
